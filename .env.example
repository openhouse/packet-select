# Example environment file for packet-select
#
# Usage:
#   1. Copy this file to `.env`
#   2. Edit OPENAI_API_KEY with your real key
#   3. Load it into your shell before running packet-select, e.g.:
#        set -a; source .env; set +a
#
# packet-select will read OPENAI_API_KEY from the environment.

OPENAI_API_KEY=sk-your-openai-api-key-goes-here
